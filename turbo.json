{
	"$schema": "./node_modules/turbo/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["bin/**", "dist/**", "lib/**"],
			"env": ["GITHUB_PAGES"]
		},
		"@nsis/lumis-wasm#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["index.d.ts", "index.js", "lumis.json", "*.wasm"]
		},
		"@nsis/parser#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "src/grammar.js", "src/grammar.d.ts"]
		},
		"lint:biome": {},
		"lint:rust": {
			"inputs": ["src/**/*.rs", "Cargo.toml", "Cargo.lock", "rustfmt.toml"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
