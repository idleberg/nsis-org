---
import { language } from '@nsis/twinkleplop';
import '@twinkleplop/theme-atom-one/dark';
import example from '../../data/example.nsi?raw';
import DemoLayout from '../../layouts/DemoLayout.astro';

const html = language()(example);
---

<DemoLayout
	title="Playground | @nsis/twinkleplop"
	description="NSIS language support for twinkleplop"
	packageName="@nsis/twinkleplop"
	footerUrl="https://github.com/idleberg/nsis-org/tree/main/packages/twinkleplop"
>
	<Fragment slot="description">
		A language definition for <a class="text-indigo-600 dark:text-indigo-400" href="https://nsis.sourceforge.io">NSIS</a> to use with <a class="text-indigo-600 dark:text-indigo-400" href="https://twinkleplop.pngwn.at">twinkleplop</a>, a fast syntax highlighter driven by compiled grammars.
	</Fragment>

	<div slot="example" id="output" class="mt-3 rounded overflow-hidden" set:html={html} />
</DemoLayout>

<style>
	#output :global(pre) {
		/* The theme defines these tokens but leaves applying them to us; punctuation is Atom One's default foreground. */
		background: var(--twp-background);
		color: var(--twp-punctuation);
		padding: 0.75rem;
		margin: 0;
		overflow-x: auto;
	}
</style>
