{
	"name": "@nsis/parser",
	"version": "0.1.2",
	"description": "Parser for NSIS scripts",
	"license": "MIT",
	"scripts": {
		"build": "npm run build:peggy && npm run build:lib",
		"build:lib": "tsdown",
		"build:peggy": "peggy --format es --dts --output src/grammar.js src/grammar.pegjs",
		"dev": "concurrently --prefix-colors blue,green npm:dev:*",
		"dev:lib": "npm run build:lib -- --watch",
		"dev:peggy": "npm run build:peggy -- --watch",
		"lint:biome": "biome check",
		"prepublishOnly": "npm run build",
		"pretest": "npm run build:peggy",
		"test": "vitest run"
	},
	"files": [
		"dist/",
		"LICENSE",
		"package.json",
		"README.md"
	],
	"type": "module",
	"exports": "./src/index.ts",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/nsis-org.git"
	},
	"homepage": "https://github.com/idleberg/nsis-org/tree/main/packages/parser#readme",
	"keywords": [
		"nsis",
		"parser",
		"peg",
		"grammar"
	],
	"publishConfig": {
		"access": "public",
		"typings": "dist/index.d.mts",
		"exports": "./dist/index.mjs"
	},
	"devDependencies": {
		"peggy": "^5.1.0",
		"vitest": "catalog:"
	}
}
