{
	"$schema": "https://idleberg.github.io/nsis-org/dent-spec/schemas/v1/blocks.schema.json",
	"open": [
		"!if",
		"!ifdef",
		"!ifmacrodef",
		"!ifmacrondef",
		"!ifndef",
		"!macro",
		"${Do}",
		"${DoUntil}",
		"${DoWhile}",
		"${For}",
		"${ForEach}",
		"${If}",
		"${IfNot}",
		"${MementoSection}",
		"${MementoSectionEx}",
		"${MementoUnselectedSection}",
		"${Select}",
		"${Switch}",
		"${Unless}",
		"${While}",
		"Function",
		"PageEx",
		"Section",
		"SectionGroup"
	],
	"case": [
		"${Case_Else}",
		"${Case}",
		"${Case2}",
		"${Case3}",
		"${Case4}",
		"${Case5}",
		"${CaseElse}",
		"${Default}"
	],
	"close": [
		"!endif",
		"!macroend",
		"${EndIf}",
		"${EndSelect}",
		"${EndSwitch}",
		"${EndUnless}",
		"${EndWhile}",
		"${Loop}",
		"${LoopUntil}",
		"${LoopWhile}",
		"${MementoSectionEnd}",
		"${Next}",
		"FunctionEnd",
		"PageExEnd",
		"SectionEnd",
		"SectionGroupEnd"
	],
	"mid": [
		"!else",
		"${AndIf}",
		"${AndIfNot}",
		"${AndUnless}",
		"${Else}",
		"${ElseIf}",
		"${ElseIfNot}",
		"${ElseUnless}",
		"${OrIf}",
		"${OrIfNot}",
		"${OrUnless}"
	],
	"closeAfter": ["${Break}"]
}
