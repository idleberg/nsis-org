			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./lumis.json": "./lumis.json",
		"./tree-sitter-nsis.wasm": "./tree-sitter-nsis.wasm"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"files": [
