{
	"name": "@nsis/lumis-wasm",
	"version": "0.26.1",
	"description": "Self-contained Lumis language package for NSIS",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/nsis-org.git"
	},
	"homepage": "https://github.com/idleberg/nsis-org/tree/main/packages/lumis-wasm#readme",
	"keywords": [
