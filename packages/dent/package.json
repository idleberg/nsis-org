{
	"name": "@nsis/dent",
	"version": "0.13.0",
	"description": "An opinionated code formatter for NSIS scripts",
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"dev": "npm run build -- --watch",
		"lint": "concurrently --prefix-colors blue,green,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:biome:ci": "biome ci",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"prepublishOnly": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "vitest run"
	},
	"files": [
		"dist/",
		"types/",
		"LICENSE",
		"package.json",
		"README.md"
	],
	"type": "module",
	"exports": "./src/dent.ts",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/nsis-org.git"
	},
	"homepage": "https://github.com/idleberg/nsis-org/tree/main/packages/dent#readme",
	"keywords": [
		"nsis",
		"formatter"
	],
	"publishConfig": {
		"access": "public",
		"typings": "./dist/dent.d.mts",
		"exports": "./dist/dent.mjs"
	},
	"dependencies": {
		"@nsis/parser": "workspace:*",
		"detect-newline": "^4.0.1"
	},
	"devDependencies": {
		"vitest": "catalog:"
	}
}
